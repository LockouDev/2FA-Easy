{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2FA Easy",
  "version": "0.1.2",
  "identifier": "com.lockoudev.2faeasy.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "2FA Easy",
        "width": 800,
        "height": 560,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "startMenuFolder": "2FA Easy"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQ0FGMzkyNjBBRTg3RUQKUldUdGg2NWdrdlBLb1l3T1lRaGhuTndZaXhCRnErMzFmcWdxOWUyclEvejc5NFhrYThLQzZDY0QK",
      "endpoints": [
        "https://github.com/LockouDev/2FA-Easy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
